(function () {
    var modal = document.getElementById('remove-student-modal');
    var backdrop = document.getElementById('remove-student-modal-backdrop');
    var cancelBtn = document.getElementById('remove-student-modal-cancel');
    var confirmBtn = document.getElementById('remove-student-modal-confirm');
    var textEl = document.getElementById('remove-student-modal-text');
    var errEl = document.getElementById('remove-student-modal-error');
    var pendingId = null;

    function openRemove(studentId, studentName) {
        pendingId = studentId;
        if (textEl) {
            textEl.textContent =
                'Remove ' + studentName + ' from this class? Their XP will be lost.';
        }
        if (errEl) {
            errEl.classList.add('hidden');
            errEl.textContent = '';
        }
        if (modal) {
            modal.classList.remove('hidden');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeRemove() {
        pendingId = null;
        if (modal) {
            modal.classList.add('hidden');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }
    }

    if (backdrop) backdrop.addEventListener('click', closeRemove);
    if (cancelBtn) cancelBtn.addEventListener('click', closeRemove);

    document.addEventListener('keydown', function (ev) {
        if (ev.key !== 'Escape' || !modal || modal.classList.contains('hidden')) return;
        closeRemove();
    });

    document.addEventListener('click', function (ev) {
        var trigger = ev.target.closest('.remove-student-trigger');
        if (!trigger) return;
        var sid = trigger.getAttribute('data-student-id');
        var sname = trigger.getAttribute('data-student-name') || '';
        if (sid) openRemove(sid, sname);
    });

    if (confirmBtn) {
        confirmBtn.addEventListener('click', async function () {
            if (!pendingId) return;
            if (errEl) {
                errEl.classList.add('hidden');
                errEl.textContent = '';
            }
            confirmBtn.disabled = true;
            try {
                var res = await fetch('/class/student/delete/' + encodeURIComponent(pendingId), {
                    method: 'POST',
                    headers: { Accept: 'application/json' },
                    credentials: 'same-origin'
                });
                var data = await res.json().catch(function () {
                    return {};
                });
                if (!res.ok || !data.ok) {
                    if (errEl) {
                        errEl.textContent = 'Could not remove student. Try again.';
                        errEl.classList.remove('hidden');
                    }
                    confirmBtn.disabled = false;
                    return;
                }
                closeRemove();
            } catch (e) {
                if (errEl) {
                    errEl.textContent = 'Network error. Try again.';
                    errEl.classList.remove('hidden');
                }
            }
            confirmBtn.disabled = false;
        });
    }
})();

(function () {
    var modal = document.getElementById('broadcast-class-modal');
    var openBtn = document.getElementById('open-broadcast-class-modal');
    var backdrop = document.getElementById('broadcast-class-modal-backdrop');
    var cancelBtn = document.getElementById('broadcast-class-modal-cancel');
    var sendBtn = document.getElementById('broadcast-class-modal-send');
    var textarea = document.getElementById('broadcast-class-message');
    var errEl = document.getElementById('broadcast-class-modal-error');
    var drawer = document.getElementById('class-manage-drawer');
    var menuBtn = document.getElementById('class-manage-menu-btn');
    var listRoot = document.getElementById('student-xp-list');
    var classId = listRoot ? listRoot.getAttribute('data-class-id') : '';

    function closeDrawerIfOpen() {
        if (!drawer || drawer.getAttribute('data-open') !== 'true') return;
        drawer.setAttribute('data-open', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
        ccTailwindRefresh();
    }

    function hideError() {
        if (errEl) {
            errEl.classList.add('hidden');
            errEl.textContent = '';
        }
    }

    function openModal() {
        if (!modal) return;
        hideError();
        closeDrawerIfOpen();
        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (textarea) {
            textarea.value = '';
            window.setTimeout(function () {
                textarea.focus();
            }, 0);
        }
        if (sendBtn) sendBtn.disabled = false;
    }

    function closeModal() {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        hideError();
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    if (sendBtn) {
        sendBtn.addEventListener('click', async function () {
            if (!classId) return;
            hideError();
            var raw = textarea ? textarea.value : '';
            if (!String(raw).trim()) {
                if (errEl) {
                    errEl.textContent = 'Enter a message to send.';
                    errEl.classList.remove('hidden');
                }
                return;
            }
            sendBtn.disabled = true;
            try {
                var res = await fetch('/class/broadcast-message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ classId: classId, message: raw })
                });
                var data = await res.json().catch(function () {
                    return {};
                });
                if (!res.ok || !data.ok) {
                    var errKey = data && data.error;
                    var msg =
                        errKey === 'forbidden'
                            ? 'You are not allowed to send for this class.'
                            : errKey === 'empty_message'
                              ? 'Message was empty after trimming.'
                              : 'Could not send message. Try again.';
                    if (errEl) {
                        errEl.textContent = msg;
                        errEl.classList.remove('hidden');
                    }
                    sendBtn.disabled = false;
                    return;
                }
                closeModal();
                if (typeof ccTailwindRefresh === 'function') ccTailwindRefresh();
            } catch (e) {
                if (errEl) {
                    errEl.textContent = 'Network error. Try again.';
                    errEl.classList.remove('hidden');
                }
                sendBtn.disabled = false;
            }
        });
    }

    document.addEventListener('keydown', function (ev) {
        if (ev.key !== 'Escape' || !modal || modal.classList.contains('hidden')) return;
        closeModal();
    });
})();

function formatXpDeltaLabel(n) {
    var x = Number(n);
    if (!Number.isFinite(x)) return String(n);
    return (x >= 0 ? '+' : '') + x;
}

function xpPendingClockSvg() {
    return (
        '<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">' +
        '<circle cx="12" cy="12" r="9"/>' +
        '<path d="M12 7v5l3 2"/>' +
        '</svg>'
    );
}

async function giveXP(studentId, xpAmount, classId, studentName) {
    var statusArea = document.getElementById('status-' + studentId);
    if (!statusArea) return;

    var amt = typeof xpAmount === 'number' ? xpAmount : parseInt(String(xpAmount), 10);
    if (!Number.isFinite(amt) || amt === 0) return;

    clearPendingTimers(studentId);
    statusArea.innerHTML = '';

    var deltaStr = formatXpDeltaLabel(amt);
    var sec = 5;
    function syncUndoLabel() {
        var el = document.getElementById('undo-sec-' + studentId);
        if (el) el.textContent = String(sec);
    }

    statusArea.innerHTML =
        '<div class="flex flex-row flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-500/25 bg-gradient-to-b from-amber-950/35 to-zinc-950/40 px-3 py-2.5">' +
        '<div class="flex min-w-0 items-center gap-3">' +
        '<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-amber-500/20 bg-amber-500/10 text-amber-300/95">' +
        xpPendingClockSvg() +
        '</span>' +
        '<div class="min-w-0 text-sm leading-snug text-zinc-300">' +
        '<span class="text-zinc-500">Pending </span>' +
        '<strong id="undo-delta-' +
        studentId +
        '" class="font-semibold tabular-nums text-amber-100">' +
        deltaStr +
        ' XP</strong>' +
        '<span class="text-zinc-500"> · applies in </span>' +
        '<span id="undo-sec-' +
        studentId +
        '" class="inline-block min-w-[1.25rem] font-semibold tabular-nums text-white">5</span>' +
        '<span class="text-zinc-500">s</span>' +
        '</div></div>' +
        '<button type="button" id="undo-' +
        studentId +
        '" class="undo-xp-btn shrink-0 rounded-lg border border-zinc-600/70 bg-zinc-900/80 px-4 py-2 text-center text-xs font-semibold uppercase tracking-wide text-zinc-200 transition hover:border-zinc-500 hover:bg-zinc-800 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500/40">' +
        'Cancel' +
        '</button></div>';
    if (typeof ccTailwindRefresh === 'function') ccTailwindRefresh();
    var undoBtn = document.getElementById('undo-' + studentId);
    undoBtn.onclick = function () {
        cancelXP(studentId);
    };

    var intervalId = setInterval(function () {
        sec--;
        if (sec < 1) {
            clearInterval(intervalId);
            return;
        }
        syncUndoLabel();
    }, 1000);

    var timeoutId = setTimeout(async function () {
        clearInterval(intervalId);
        statusArea.innerHTML =
            '<div class="flex items-center gap-2 rounded-lg border border-emerald-500/25 bg-emerald-950/30 px-3 py-2 text-xs font-medium text-emerald-300">' +
            '<span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]" aria-hidden="true"></span>' +
            'Saved to leaderboard' +
            '</div>';
        if (typeof ccTailwindRefresh === 'function') ccTailwindRefresh();

        await fetch('/class/award-xp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ studentId, xpAmount: amt, classId, studentName })
        });

        setTimeout(function () {
            if (statusArea) statusArea.innerHTML = '';
        }, 2000);
        delete pendingActions[studentId];
    }, 5000);

    pendingActions[studentId] = { timeoutId: timeoutId, intervalId: intervalId };
}

function cancelXP(studentId) {
    clearPendingTimers(studentId);
    var el = document.getElementById('status-' + studentId);
    if (el) el.innerHTML = '';
}

function applyStudentSearchFilter() {
    var searchInput = document.getElementById('student-search');
    var list = document.getElementById('student-xp-list');
    if (!searchInput || !list) return;
    var query = searchInput.value.trim().toLowerCase();
    var rows = list.querySelectorAll('.student-xp-row');
    rows.forEach(function (row) {
        var raw = row.getAttribute('data-student-name');
        var name = raw != null ? String(raw).trim() : '';
        if (!query || name.toLowerCase().indexOf(query) !== -1) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}

function rebuildStudentXpList(students) {
    clearAllPendingTimers();

    var root = document.getElementById('student-xp-list');
    if (!root) return;

    var list = (students || []).slice().sort(function (a, b) {
        var na = String(a && a.name != null ? a.name : '');
        var nb = String(b && b.name != null ? b.name : '');
        var cmp = na.localeCompare(nb, undefined, { sensitivity: 'base' });
        if (cmp !== 0) return cmp;
        return (Number(a.id) || 0) - (Number(b.id) || 0);
    });

    studentNameById = {};
    studentXpById = {};
    list.forEach(function (s) {
        var sid = String(s.id);
        studentNameById[sid] = s.name;
        studentXpById[sid] = s.xp != null ? Number(s.xp) : 0;
    });

    root.innerHTML = '';
    if (!list.length) {
        var empty = document.createElement('p');
        empty.className =
            'rounded-xl border border-zinc-800 bg-[#111] px-3 py-6 text-center text-sm text-zinc-500 sm:px-4 sm:py-8';
        empty.textContent = 'No students yet.';
        root.appendChild(empty);
        if (typeof ccTailwindRefresh === 'function') ccTailwindRefresh();
        applyStudentSearchFilter();
        return;
    }

    var deductCls =
        'xp-award-btn min-w-[3.25rem] rounded-lg border border-rose-500/25 bg-rose-950/40 px-2 py-2 text-center text-sm font-semibold tabular-nums text-rose-200 shadow-sm transition hover:border-rose-400/40 hover:bg-rose-950/65 hover:text-rose-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/35 active:scale-[0.97]';
    var addCls =
        'xp-award-btn min-w-[3.25rem] rounded-lg border border-emerald-500/25 bg-emerald-950/40 px-2 py-2 text-center text-sm font-semibold tabular-nums text-emerald-200 shadow-sm transition hover:border-emerald-400/40 hover:bg-emerald-950/65 hover:text-emerald-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/35 active:scale-[0.97]';

    list.forEach(function (student) {
        var sid = String(student.id);
        var xpVal = student.xp != null ? Number(student.xp) : 0;
        var row = document.createElement('div');
        row.className =
            'student-xp-row rounded-2xl border border-zinc-800/90 bg-[#111] p-4 shadow-sm shadow-black/20';
        row.setAttribute('data-student-id', sid);
        row.setAttribute('data-student-name', student.name != null ? String(student.name) : '');

        var header = document.createElement('div');
        header.className = 'flex flex-wrap items-center gap-x-3 gap-y-2';
        var nameSpan = document.createElement('span');
        nameSpan.className = 'min-w-0 break-words text-base font-medium text-zinc-100';
        nameSpan.textContent = student.name;
        var xpSpan = document.createElement('span');
        xpSpan.className =
            'student-xp-total inline-flex shrink-0 items-center rounded-lg border border-zinc-700/60 bg-zinc-900/60 px-2.5 py-1 text-xs font-medium tabular-nums tracking-tight text-zinc-300';
        xpSpan.textContent = xpVal + ' XP';
        var rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.className =
            'remove-student-trigger ml-auto inline-flex shrink-0 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-1.5 text-zinc-700 transition hover:bg-zinc-800/50 hover:text-zinc-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500/30';
        rmBtn.setAttribute('data-student-id', sid);
        rmBtn.setAttribute('data-student-name', student.name);
        rmBtn.setAttribute('aria-label', 'Remove ' + student.name);
        rmBtn.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/><path d="M10 11v6M14 11v6"/></svg>';
        header.appendChild(nameSpan);
        header.appendChild(xpSpan);
        header.appendChild(rmBtn);

        var adjustWrap = document.createElement('div');
        adjustWrap.className = 'mt-3 rounded-xl border border-zinc-800/80 bg-[#0a0a0a] p-2.5';
        adjustWrap.setAttribute('aria-label', 'Adjust experience points');
        var adjustInner = document.createElement('div');
        adjustInner.className = 'flex flex-row flex-wrap items-stretch gap-2 sm:gap-0';

        var deductCol = document.createElement('div');
        deductCol.className =
            'flex min-w-0 flex-1 flex-wrap items-center justify-start gap-1.5 sm:px-1';
        [-10, -5].forEach(function (points) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = deductCls;
            btn.setAttribute('data-points', String(points));
            btn.textContent = String(points);
            deductCol.appendChild(btn);
        });

        var divider = document.createElement('div');
        divider.className = 'mx-1 w-px shrink-0 self-stretch bg-zinc-800 sm:mx-2';
        divider.setAttribute('aria-hidden', 'true');

        var addCol = document.createElement('div');
        addCol.className =
            'flex min-w-0 flex-1 flex-wrap items-center justify-end gap-1.5 sm:px-1';
        [5, 10].forEach(function (points) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = addCls;
            btn.setAttribute('data-points', String(points));
            btn.textContent = '+' + points;
            addCol.appendChild(btn);
        });

        adjustInner.appendChild(deductCol);
        adjustInner.appendChild(divider);
        adjustInner.appendChild(addCol);
        adjustWrap.appendChild(adjustInner);

        var statusSpan = document.createElement('div');
        statusSpan.id = 'status-' + sid;
        statusSpan.className = 'mt-2 min-h-0';

        row.appendChild(header);
        row.appendChild(adjustWrap);
        row.appendChild(statusSpan);
        root.appendChild(row);
    });
    if (typeof ccTailwindRefresh === 'function') ccTailwindRefresh();
    applyStudentSearchFilter();
}

(function () {
    var root = document.getElementById('student-xp-list');
    if (!root) return;
    var classId = root.getAttribute('data-class-id');
    var viewId = root.getAttribute('data-view-id') || '';
    root.addEventListener('click', function (ev) {
        var btn = ev.target.closest('.xp-award-btn');
        if (!btn || !root.contains(btn)) return;
        var row = btn.closest('.student-xp-row');
        if (!row) return;
        var sid = row.getAttribute('data-student-id');
        var pts = btn.getAttribute('data-points');
        var name = studentNameById[sid] || '';
        giveXP(sid, pts, classId, name);
    });

    if (!classId) return;
    var proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    var wsUrl = proto + '//' + window.location.host + '/ws?classId=' + encodeURIComponent(classId);
    var reconnectTimer;
    var teacherPdfCtl = null;

    function connect() {
        var ws;
        try {
            ws = new WebSocket(wsUrl);
        } catch (e) {
            scheduleReconnect();
            return;
        }
        ws.onopen = function () {
            if (reconnectTimer) {
                clearTimeout(reconnectTimer);
                reconnectTimer = null;
            }
        };
        ws.onmessage = function (ev) {
            try {
                var data = JSON.parse(ev.data);
                if (data.type === 'leaderboard' && Array.isArray(data.students)) {
                    rebuildStudentXpList(data.students);
                } else if (data.type === 'announcement' && typeof data.message === 'string') {
                    showClassLiveAnnouncement(data.message);
                } else if (data.type === 'pdf_sync' && teacherPdfCtl) {
                    teacherPdfCtl.onPdfSyncMessage(data);
                }
            } catch (err) {
                /* ignore */
            }
        };
        ws.onclose = function () {
            scheduleReconnect();
        };
        ws.onerror = function () {
            try {
                ws.close();
            } catch (e) {}
        };
    }

    function scheduleReconnect() {
        if (reconnectTimer) return;
        reconnectTimer = window.setTimeout(function () {
            reconnectTimer = null;
            connect();
        }, 2500);
    }

    function startSocket() {
        connect();
    }

    var mainPdf = document.getElementById('cc-teacher-pdf-root');
    var modalPdf = document.getElementById('cc-pdf-modal-slot');
    if (typeof ClassPdfSync !== 'undefined' && viewId && mainPdf) {
        var bootPdf = {};
        try {
            var pb = document.getElementById('class-manage-pdf-bootstrap');
            if (pb && pb.textContent) bootPdf = JSON.parse(pb.textContent);
        } catch (pe) {
            bootPdf = {};
        }
        ClassPdfSync.initTeacher({
            classId: classId,
            viewId: viewId,
            bootstrap: bootPdf,
            mainRoot: mainPdf,
            pdfStage: document.getElementById('cc-teacher-pdf-stage'),
            modalRoot: modalPdf || null
        }).then(function (ctl) {
            teacherPdfCtl = ctl;
            window.__ccTeacherPdfCtl = ctl;
            startSocket();
        });
    } else {
        startSocket();
    }
})();
</script>

