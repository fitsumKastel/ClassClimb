<%- include('partials/header') %>
<link rel="stylesheet" href="/css/class-theater.css" />

<div id="cc-teacher-layout" class="cc-teacher-layout bg-[#000] text-white">
    <aside class="cc-teacher-rail-left" aria-label="Class tools">
        <a
            href="<%= typeof headerBackHref !== 'undefined' && headerBackHref ? headerBackHref : '/' %>"
            id="cc-rail-back"
            class="cc-teacher-rail-btn inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-400 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40"
            title="<%= typeof headerBackLabel !== 'undefined' && headerBackLabel ? headerBackLabel : 'Back' %>"
            aria-label="<%= typeof headerBackLabel !== 'undefined' && headerBackLabel ? headerBackLabel : 'Back' %>"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </a>
        <a href="/" class="mb-1 inline-flex h-9 w-9 items-center justify-center rounded-lg text-[10px] font-black italic leading-none text-white transition hover:bg-zinc-900" title="ClassClimb home">CC</a>
        <a href="/view/<%= classInfo.id %>" class="cc-teacher-rail-btn inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-400 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40" title="Leaderboard" aria-label="Open leaderboard">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18" /><path d="M7 17l4-8 4 4 5-8" /></svg>
        </a>
        <button type="button" id="cc-rail-open-add-students" class="cc-teacher-rail-btn inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-400 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40" title="Add students" aria-label="Add students">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </button>
        <button type="button" id="cc-rail-open-broadcast" class="cc-teacher-rail-btn inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-400 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40" title="Message class" aria-label="Message class">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
        </button>
        <button type="button" id="cc-rail-open-drawer" class="cc-teacher-rail-btn mt-auto inline-flex h-10 w-10 items-center justify-center rounded-lg text-zinc-400 transition hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40" title="More class tools" aria-label="More class tools">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
    </aside>
    <div class="cc-teacher-content mx-auto w-full flex-1 px-3 py-4 pb-8 sm:px-4 sm:py-6 lg:min-w-0 landscape:mx-0 landscape:max-w-none landscape:w-full landscape:p-0">
        <section class="cc-teacher-stage flex min-h-0 flex-1 flex-col" aria-labelledby="student-list-heading">
            <h2 id="student-list-heading" class="sr-only">Students and experience points</h2>
            <p
                class="cc-teacher-portrait-title mb-3 max-w-full break-words text-center text-[10px] leading-tight tracking-tight text-zinc-600 sm:mb-4"
                title="Teacher console · <%= classInfo.class_name %><%= classInfo.school_name ? ' · ' + classInfo.school_name : '' %>"
            >
                Teacher console · <%= classInfo.class_name %><% if (classInfo.school_name) { %> · <%= classInfo.school_name %><% } %>
            </p>
            <div class="cc-teacher-side-top mb-3 px-0 landscape:mb-0 landscape:px-3 landscape:py-3">
                <input
                    type="text"
                    id="student-search"
                    placeholder="Search students..."
                    autocomplete="off"
                    class="w-full select-text rounded-xl border border-zinc-800 bg-[#111] px-3.5 py-2.5 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-blue-500/60 focus:ring-2 focus:ring-blue-500/20"
                />
                <div
                    id="class-live-announcement"
                    class="mt-3 hidden rounded-xl border border-sky-500/35 bg-sky-950/35 px-3.5 py-3 text-sm text-sky-100 shadow-sm"
                    role="status"
                    aria-live="polite"
                >
                <div class="flex items-start gap-2">
                    <div class="min-w-0 flex-1">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-sky-400/90">Class message</p>
                        <p id="class-live-announcement-body" class="mt-1 whitespace-pre-wrap break-words text-zinc-100"></p>
                    </div>
                    <button
                        type="button"
                        id="class-live-announcement-dismiss"
                        class="shrink-0 rounded-lg border border-zinc-600/80 bg-zinc-900/80 px-2.5 py-1 text-xs font-medium text-zinc-200 transition hover:bg-zinc-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/40"
                    >
                        Dismiss
                    </button>
                </div>
            </div>
            <div id="cc-teacher-pdf-stage" class="cc-teacher-pdf-stage mb-3 min-h-0 w-full landscape:mb-0">
                <div id="cc-teacher-pdf-root" class="flex min-h-0 w-full flex-1 flex-col"></div>
            </div>
            <div id="student-xp-list" class="cc-teacher-side-students space-y-3 px-0 landscape:min-h-0 landscape:overflow-y-auto landscape:px-3 landscape:pb-3 landscape:pt-2" data-class-id="<%= classInfo.id %>" data-view-id="<%= classInfo.view_id %>">
                <% if (students.length === 0) { %>
                    <p class="rounded-xl border border-zinc-800 bg-[#111] px-3 py-6 text-center text-sm text-zinc-500 sm:px-4 sm:py-8">
                        No students yet.
                    </p>
                <% } %>
                <% students.forEach((student) => { %>
                    <div
                        class="student-xp-row rounded-2xl border border-zinc-800/90 bg-[#111] p-4 shadow-sm shadow-black/20"
                        data-student-id="<%= student.id %>"
                        data-student-name="<%= student.name %>"
                    >
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                            <span class="min-w-0 break-words text-base font-medium text-zinc-100"><%= student.name %></span>
                            <span
                                class="student-xp-total inline-flex shrink-0 items-center rounded-lg border border-zinc-700/60 bg-zinc-900/60 px-2.5 py-1 text-xs font-medium tabular-nums tracking-tight text-zinc-300"
                                ><%= student.xp %> XP</span>
                            <button
                                type="button"
                                class="remove-student-trigger ml-auto inline-flex shrink-0 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-1.5 text-zinc-700 transition hover:bg-zinc-800/50 hover:text-zinc-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500/30"
                                data-student-id="<%= student.id %>"
                                data-student-name="<%= student.name %>"
                                aria-label="Remove <%= student.name %>"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M3 6h18" />
                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z" />
                                    <path d="M10 11v6M14 11v6" />
                                </svg>
                            </button>
                        </div>

                        <div
                            class="mt-3 rounded-xl border border-zinc-800/80 bg-[#0a0a0a] p-2.5"
                            aria-label="Adjust experience points"
                        >
                            <div class="flex flex-row flex-wrap items-stretch gap-2 sm:gap-0">
                                <div class="flex min-w-0 flex-1 flex-wrap items-center justify-start gap-1.5 sm:px-1">
                                    <% [-10, -5].forEach((points) => { %>
                                        <button
                                            type="button"
                                            class="xp-award-btn min-w-[3.25rem] rounded-lg border border-rose-500/25 bg-rose-950/40 px-2 py-2 text-center text-sm font-semibold tabular-nums text-rose-200 shadow-sm transition hover:border-rose-400/40 hover:bg-rose-950/65 hover:text-rose-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/35 active:scale-[0.97]"
                                            data-points="<%= points %>"
                                        >
                                            <%= points %>
                                        </button>
                                    <% }) %>
                                </div>
                                <div
                                    class="mx-1 w-px shrink-0 self-stretch bg-zinc-800 sm:mx-2"
                                    aria-hidden="true"
                                ></div>
                                <div class="flex min-w-0 flex-1 flex-wrap items-center justify-end gap-1.5 sm:px-1">
                                    <% [5, 10].forEach((points) => { %>
                                        <button
                                            type="button"
                                            class="xp-award-btn min-w-[3.25rem] rounded-lg border border-emerald-500/25 bg-emerald-950/40 px-2 py-2 text-center text-sm font-semibold tabular-nums text-emerald-200 shadow-sm transition hover:border-emerald-400/40 hover:bg-emerald-950/65 hover:text-emerald-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/35 active:scale-[0.97]"
                                            data-points="<%= points %>"
                                        >
                                            +<%= points %>
                                        </button>
                                    <% }) %>
                                </div>
                            </div>
                        </div>

                        <div id="status-<%= student.id %>" class="mt-2 min-h-0"></div>
                    </div>
                <% }) %>
            </div>
        </section>
    </div>
</div>

<div id="class-manage-drawer" class="<%= ccDrawerRoot %>" data-open="false" aria-hidden="true">
    <button
        type="button"
        id="class-manage-drawer-backdrop"
        class="<%= ccDrawerBackdrop %>"
        aria-label="Close class tools"
    ></button>
    <aside
        id="class-manage-drawer-panel"
        class="<%= ccDrawerPanel %>"
        role="dialog"
        aria-modal="true"
        aria-labelledby="class-manage-drawer-title"
    >
        <div
            class="flex shrink-0 items-center justify-between border-b border-zinc-800 px-4 pb-3.5"
            style="background-color: #000000; padding-top: max(1.5rem, env(safe-area-inset-top, 0px))"
        >
            <p id="class-manage-drawer-title" class="text-sm font-semibold tracking-tight text-white">Class tools</p>
            <button
                type="button"
                id="class-manage-drawer-close"
                class="p-2 text-white transition-opacity hover:opacity-70 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
                aria-label="Close class tools"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto px-4 pb-6 pt-10" style="background-color: #000000">
            <nav class="flex w-full flex-col items-stretch space-y-8 text-left" aria-label="Class tools">
                <section>
                    <ul class="m-0 w-full list-none space-y-1.5 p-0">
                        <li class="w-full">
                            <a href="/view/<%= classInfo.id %>" class="<%= ccDrawerNavItem %>">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4 shrink-0 text-white"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    aria-hidden="true"
                                >
                                    <path d="M3 3v18h18" />
                                    <path d="M7 17l4-8 4 4 5-8" />
                                </svg>
                                <span>Leaderboard</span>
                            </a>
                        </li>
                        <li class="w-full">
                            <button type="button" id="open-add-students-modal" class="<%= ccDrawerNavItem %>">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4 shrink-0 text-white"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    aria-hidden="true"
                                >
                                    <path d="M12 5v14M5 12h14" />
                                </svg>
                                <span>Add students</span>
                            </button>
                        </li>
                        <li class="w-full">
                            <button type="button" id="open-broadcast-class-modal" class="<%= ccDrawerNavItem %>">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4 shrink-0 text-white"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    aria-hidden="true"
                                >
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                </svg>
                                <span>Message class</span>
                            </button>
                        </li>
                    </ul>
                </section>
                <section class="border-t border-zinc-800 pt-6">
                    <h3 class="mb-2 px-1 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Account</h3>
                    <button type="button" id="class-manage-drawer-logout" class="<%= ccDrawerNavItem %>">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4 shrink-0 opacity-90"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                        >
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        <span>Log out</span>
                    </button>
                </section>
            </nav>
        </div>
    </aside>
</div>

<div
    id="add-students-modal"
    class="fixed inset-0 z-[120] hidden flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="add-students-modal-title"
    aria-hidden="true"
>
    <button
        type="button"
        id="add-students-modal-backdrop"
        class="absolute inset-0 bg-black/70"
        aria-label="Close dialog"
    ></button>
    <div class="relative z-10 max-h-[min(90vh,32rem)] w-full max-w-lg overflow-y-auto rounded-xl border border-zinc-800 bg-[#111] p-5 shadow-xl">
        <h2 id="add-students-modal-title" class="text-base font-semibold text-white">Add students</h2>
        <form
            action="/class/bulk-add/<%= classInfo.view_id %>"
            method="POST"
            class="mt-4 space-y-3"
            autocomplete="off"
        >
            <input type="hidden" name="_formNonce" value="<%= bulkFormNonce %>">
            <div id="cc-pdf-modal-slot" class="mb-3 min-h-0 w-full"></div>
            <textarea
                id="bulk-student-list"
                name="studentList"
                rows="8"
                placeholder="Paste names here..."
                autocomplete="off"
                class="w-full select-text resize-y rounded-lg border border-zinc-800 bg-[#050505] p-3 text-sm text-white placeholder-zinc-600 outline-none focus:border-blue-600"
            ></textarea>
            <div class="flex flex-wrap justify-end gap-3 pt-1">
                <button
                    type="button"
                    id="add-students-modal-cancel"
                    class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-white"
                >
                    Cancel
                </button>
                <button
                    type="submit"
                    id="add-students-submit"
                    class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-60"
                >
                    Save students
                </button>
            </div>
        </form>
    </div>
</div>

<div
    id="remove-student-modal"
    class="fixed inset-0 z-[120] hidden flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="remove-student-modal-title"
    aria-hidden="true"
>
    <button
        type="button"
        id="remove-student-modal-backdrop"
        class="absolute inset-0 bg-black/70"
        aria-label="Close dialog"
    ></button>
    <div class="relative z-10 w-full max-w-md rounded-xl border border-zinc-800 bg-[#111] p-5 shadow-xl">
        <h2 id="remove-student-modal-title" class="text-base font-semibold text-white">Remove student?</h2>
        <p id="remove-student-modal-text" class="mt-2 text-sm text-zinc-400"></p>
        <p id="remove-student-modal-error" class="mt-2 hidden text-sm text-red-400"></p>
        <div class="mt-6 flex flex-wrap justify-end gap-3">
            <button
                type="button"
                id="remove-student-modal-cancel"
                class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-white"
            >
                Cancel
            </button>
            <button
                type="button"
                id="remove-student-modal-confirm"
                class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-500 disabled:opacity-50"
            >
                Remove
            </button>
        </div>
    </div>
</div>

<div
    id="broadcast-class-modal"
    class="fixed inset-0 z-[120] hidden flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="broadcast-class-modal-title"
    aria-hidden="true"
>
    <button
        type="button"
        id="broadcast-class-modal-backdrop"
        class="absolute inset-0 bg-black/70"
        aria-label="Close dialog"
    ></button>
    <div class="relative z-10 w-full max-w-lg rounded-xl border border-zinc-800 bg-[#111] p-5 shadow-xl">
        <h2 id="broadcast-class-modal-title" class="text-base font-semibold text-white">Message everyone on this class</h2>
        <p class="mt-1 text-xs text-zinc-500">
            Anyone with the leaderboard or this teacher page open will see your message live (up to 1500 characters).
        </p>
        <textarea
            id="broadcast-class-message"
            rows="5"
            maxlength="1500"
            placeholder="Type your announcement..."
            autocomplete="off"
            class="mt-4 w-full select-text resize-y rounded-lg border border-zinc-800 bg-[#050505] p-3 text-sm text-white placeholder-zinc-600 outline-none focus:border-blue-600"
        ></textarea>
        <p id="broadcast-class-modal-error" class="mt-2 hidden text-sm text-red-400"></p>
        <div class="mt-6 flex flex-wrap justify-end gap-3">
            <button
                type="button"
                id="broadcast-class-modal-cancel"
                class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-white"
            >
                Cancel
            </button>
            <button
                type="button"
                id="broadcast-class-modal-send"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-60"
            >
                Send to class
            </button>
        </div>
    </div>
</div>

<script id="class-manage-students-json" type="application/json"><%- JSON.stringify(students.map((s) => ({ id: String(s.id), name: s.name, xp: s.xp }))) %></script>
<script id="class-manage-pdf-bootstrap" type="application/json"><%- JSON.stringify(typeof pdfSyncBootstrap !== 'undefined' ? pdfSyncBootstrap : {}) %></script>
<script src="/js/class-pdf-sync.js"></script>
<script src="/js/class-theater.js"></script>

<script>
let pendingActions = {};
var studentNameById = {};
var studentXpById = {};
try {
    var __rows = JSON.parse(document.getElementById('class-manage-students-json').textContent);
    __rows.forEach(function (r) {
        studentNameById[r.id] = r.name;
        studentXpById[r.id] = r.xp != null ? Number(r.xp) : 0;
    });
} catch (e) {
    studentNameById = {};
    studentXpById = {};
}

function wireClassLiveAnnouncementUI() {
    var wrap = document.getElementById('class-live-announcement');
    var body = document.getElementById('class-live-announcement-body');
    var dismiss = document.getElementById('class-live-announcement-dismiss');
    if (!wrap || !body) {
        return function () {};
    }
    function hideAnnouncement() {
        wrap.classList.add('hidden');
        body.textContent = '';
    }
    if (dismiss) {
        dismiss.addEventListener('click', hideAnnouncement);
    }
    return function showClassLiveAnnouncement(msg) {
        if (typeof msg !== 'string') return;
        var t = msg.trim();
        if (!t) return;
        body.textContent = t;
        wrap.classList.remove('hidden');
        if (typeof ccTailwindRefresh === 'function') ccTailwindRefresh();
    };
}
var showClassLiveAnnouncement = wireClassLiveAnnouncementUI();

function clearPendingTimers(studentId) {
    var p = pendingActions[studentId];
    if (p) {
        if (p.timeoutId) clearTimeout(p.timeoutId);
        if (p.intervalId) clearInterval(p.intervalId);
        delete pendingActions[studentId];
    }
}

function clearAllPendingTimers() {
    Object.keys(pendingActions).forEach(clearPendingTimers);
}

(function () {
    var drawer = document.getElementById('class-manage-drawer');
    var openBtn = document.getElementById('class-manage-menu-btn');
    var closeBtn = document.getElementById('class-manage-drawer-close');
    var backdrop = document.getElementById('class-manage-drawer-backdrop');

    function drawerIsOpen() {
        return drawer && drawer.getAttribute('data-open') === 'true';
    }

    function openDrawer() {
        if (!drawer) return;
        drawer.setAttribute('data-open', 'true');
        drawer.setAttribute('aria-hidden', 'false');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        ccTailwindRefresh();
    }

    function closeDrawer() {
        if (!drawer) return;
        drawer.setAttribute('data-open', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        ccTailwindRefresh();
    }

    if (openBtn) openBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    var drawerLogoutBtn = document.getElementById('class-manage-drawer-logout');
    if (drawerLogoutBtn) {
        drawerLogoutBtn.addEventListener('click', function () {
            closeDrawer();
            window.setTimeout(function () {
                var o = document.getElementById('cc-logout-open');
                if (o) o.click();
            }, 0);
        });
    }

    document.addEventListener('keydown', function (ev) {
        if (ev.key !== 'Escape' || !drawerIsOpen()) return;
        var logoutModal = document.getElementById('cc-logout-modal');
        if (logoutModal && !logoutModal.classList.contains('hidden')) return;
        var addModal = document.getElementById('add-students-modal');
        var remModal = document.getElementById('remove-student-modal');
        var broadcastModal = document.getElementById('broadcast-class-modal');
        var modalBlocking =
            (addModal && !addModal.classList.contains('hidden')) ||
            (remModal && !remModal.classList.contains('hidden')) ||
            (broadcastModal && !broadcastModal.classList.contains('hidden'));
        if (modalBlocking) return;
        closeDrawer();
    });
})();

(function () {
    var modal = document.getElementById('add-students-modal');
    var openBtn = document.getElementById('open-add-students-modal');
    var backdrop = document.getElementById('add-students-modal-backdrop');
    var cancelBtn = document.getElementById('add-students-modal-cancel');
    var textarea = document.getElementById('bulk-student-list');
    var drawer = document.getElementById('class-manage-drawer');
    var menuBtn = document.getElementById('class-manage-menu-btn');

    function closeDrawerIfOpen() {
        if (!drawer || drawer.getAttribute('data-open') !== 'true') return;
        drawer.setAttribute('data-open', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
        ccTailwindRefresh();
    }

    function openModal() {
        if (!modal) return;
        closeDrawerIfOpen();
