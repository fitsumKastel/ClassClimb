<%- include('partials/header') %>

<div class="bg-[#000] text-white flex min-h-screen flex-col items-center px-3 py-4 sm:px-4 lg:py-6">
    <div class="mx-auto w-full max-w-lg">
        <%- include('partials/teacher-create-class', {
            formNonce: formNonce,
            createHeadingId: 'teacher-start-heading',
            createHeadingTag: 'h1',
            inlineError: typeof setupError !== 'undefined' && setupError ? setupError : null
        }) %>
    </div>
</div>

<script src="/js/uppercase-input.js" defer></script>
<script src="/js/create-class-form.js"></script>
<script>
(function () {
    var form = document.getElementById('create-class-form');
    if (!form || typeof window.classclimbBindCreateClassForm !== 'function') {
        return;
    }
    window.classclimbBindCreateClassForm(form, {
        onSuccess: function (data) {
            if (data.class && data.class.view_id) {
                window.location.href = '/class/manage/' + data.class.view_id;
            }
        }
    });
})();
</script>

<%- include('partials/footer') %>
