<%- include('partials/header') %>

<div class="bg-[#000] text-white min-h-[calc(100svh-4rem)] flex flex-col items-center px-3 py-6 sm:px-4 sm:py-8">
    <div class="w-full max-w-md mx-auto my-auto">
        <div class="bg-[#111] p-4 sm:p-6 rounded-2xl border border-gray-900">
            <form action="/class/create" method="POST" class="space-y-4" autocomplete="off">
                <input type="hidden" name="_formNonce" value="<%= formNonce %>">
                <input
                    type="text"
                    name="className"
                    placeholder="CLASS NAME (e.g. 10B MATH)"
                    required
                    autocomplete="off"
                    data-uppercase-input
                    class="w-full select-text uppercase bg-[#050505] border border-gray-800 p-3 rounded-lg focus:border-blue-600 outline-none transition"
                >
                <input
                    type="text"
                    name="schoolName"
                    placeholder="SCHOOL NAME"
                    required
                    autocomplete="off"
                    data-uppercase-input
                    class="w-full select-text uppercase bg-[#050505] border border-gray-800 p-3 rounded-lg focus:border-blue-600 outline-none transition"
                >
                <button
                    type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-500 font-bold py-3 rounded-lg transition text-white"
                >
                    Create New Class
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/js/uppercase-input.js" defer></script>
<%- include('partials/footer') %>
