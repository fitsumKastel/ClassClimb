# Copy this file to `.env` in the same folder as server.js on your server,
# OR enter the same keys in cPanel → Setup Node.js Application → Environment variables.
# Do not commit a real `.env` (it is gitignored).

SITE_URL=https://classclimb.eweei.com
SITE_NAME=ClassClimb

# Required for production — use a long random string (sessions / WebSocket auth)
SESSION_SECRET=replace-with-long-random-secret

# Telegram / LinkBot (login + class links)
LINKBOT_API_KEY=
LINKBOT_SITE_SECRET=
# LINKBOT_API_BASE=https://linkbot.eweei.com/api
# LINKBOT_BOT_URL=https://t.me/Link_account_bot

# Must be 0 — if 1, the app shows an “Updating” page (not the LiteSpeed 503)
APP_UPDATE_MODE=0

# Node 18+ works (file sessions). Node 22.5+ uses SQLite for sessions automatically.

# HTTPS on classclimb.eweei.com — usually auto when SITE_URL is https://
# COOKIE_SECURE=1
# SESSION_COOKIE_SAME_SITE=lax

# Optional: writable folder outside public_html if default storage fails
# CLASSCLIMB_STORAGE_ROOT=/home/YOUR_USER/classclimb-storage

# cPanel often sets PORT automatically; only set if needed
# PORT=3000

# STATUS_PASSWORD=change-me
