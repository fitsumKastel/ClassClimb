{
    "name": "class-climb",
    "version": "1.0.0",
    "main": "server.js",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js"
    },
    "nodemonConfig": {
        "watch": [
            "server.js",
            "routes",
            "lib",
            "views"
        ],
        "ext": "js,ejs,json",
        "ignore": [
            "public/**",
            "node_modules/**"
        ]
    },
    "dependencies": {
        "axios": "^1.6.0",
        "cookie-parser": "^1.4.6",
        "ejs": "^3.1.9",
        "express": "^4.18.2",
        "express-session": "^1.17.3",
        "uuid": "^9.0.1",
        "ws": "^8.20.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}
